# Turso Database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# NextAuth
NEXTAUTH_SECRET=your-random-secret-key
NEXTAUTH_URL=http://localhost:3000

# IMS (Inventory Management System) Webhook
IMS_BASE_URL="https://your-ims-domain.com"
SALES_WEBHOOK_SECRET="shared-secret-must-match-ims-SALES_WEBHOOK_SECRET"

# IMS → Sales single sign-on
# HS256 secret for launch tokens posted to GET /api/sso/callback?token=...
# Must be the same value as IMS SSO_SHARED_SECRET.
# Distinct from SALES_WEBHOOK_SECRET (webhooks only).
# Generate with: openssl rand -base64 32
SSO_SHARED_SECRET="shared-sso-secret-must-match-ims"
