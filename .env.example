# Turso Database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# NextAuth (local Sales session cookie). Not the IMS handoff key.
NEXTAUTH_SECRET=your-random-secret-key
NEXTAUTH_URL=http://localhost:3000

# IMS SSO handoff. HS256 secret shared with IMS SSO_SHARED_SECRET.
# Minimum 32 characters. Must be distinct from NEXTAUTH_SECRET and SALES_WEBHOOK_SECRET.
# Generate: openssl rand -base64 48
# Set the same value on the Sales Vercel project. Do not commit the real secret.
SSO_SHARED_SECRET=

# IMS (Inventory Management System) Webhook
IMS_BASE_URL="https://your-ims-domain.com"
SALES_WEBHOOK_SECRET="shared-secret-must-match-ims-SALES_WEBHOOK_SECRET"
